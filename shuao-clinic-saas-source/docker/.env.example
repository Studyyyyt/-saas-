# ============================================
# 口腔门诊 SaaS 管理系统 - Docker 环境配置示例
# 复制为 .env 后修改实际值
# ============================================

# --------------------------------------------
# 数据库配置
# --------------------------------------------
DB_ROOT_PASSWORD=clinic_root_pass
DB_USER=clinic_user
DB_PASSWORD=clinic_pass
DB_PORT=3306

# --------------------------------------------
# 服务端口
# --------------------------------------------
BACKEND_PORT=8080
FRONTEND_PORT=7070
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# --------------------------------------------
# OpenAI 配置
# --------------------------------------------
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --------------------------------------------
# 微信配置
# --------------------------------------------
WECHAT_DELIVERY_MODE=mock
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_NOTICE_BASE_URL=https://example.com
WECHAT_BIND_BASE_URL=https://example.com

# --------------------------------------------
# 安全配置
# --------------------------------------------
SECURITY_PATIENT_ADMIN_SECONDARY_PASSWORD=246810

# --------------------------------------------
# JVM 参数
# --------------------------------------------
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/./urandom

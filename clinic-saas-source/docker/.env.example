# ============================================
# 口腔门诊 SaaS 管理系统 - Docker 环境配置示例
#
# 用法：
#   1. 复制此文件为 .env（cp .env.example .env）
#   2. 修改 .env 中的变量为实际值
#   3. docker compose -f docker-compose.yml up -d
#
# 注意：修改此文件后，已运行的容器不会自动加载新值，
#      需要执行 docker compose restart 或 down/up 才能生效。
# ============================================

# --------------------------------------------
# 数据库配置（必填）
# --------------------------------------------
# MySQL root 密码，用于数据库健康检查和手动维护
DB_ROOT_PASSWORD=clinic_root_pass

# 应用连接数据库的账号和密码
# 必须与 database_init.sql 中初始化的账号一致，
# 否则后端无法连接数据库。
DB_USER=clinic_user
DB_PASSWORD=clinic_pass

# --------------------------------------------
# 安全配置
# --------------------------------------------
# 患者管理模块的二级密码，用于删除患者等敏感操作
# 建议修改为不易猜测的强密码
SECURITY_PATIENT_ADMIN_SECONDARY_PASSWORD=246810

# --------------------------------------------
# JVM 参数（可选，通常不需要修改）
# --------------------------------------------
# Spring Boot 后端运行时的 JVM 参数
# UseContainerSupport 让 JVM 自动感知 Docker 内存限制
# MaxRAMPercentage=75.0 表示最多使用容器内存的 75%
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/./urandom

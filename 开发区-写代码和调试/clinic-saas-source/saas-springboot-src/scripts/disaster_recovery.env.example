# 备份输出根目录
BACKUP_ROOT=/path/to/disaster-recovery-backups

# 快照命名前缀
BACKUP_LABEL=your-saas-backup

# 保留策略
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_COUNT=30

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_database
DB_USER=your_user
DB_PASSWORD=your_password
MYSQLDUMP_EXTRA_ARGS="--single-transaction --quick --routines --events --triggers --set-gtid-purged=OFF"

# 文件与制品
UPLOAD_DIR=/path/to/uploads
SPRING_CONFIG_FILE=/path/to/application.yml
RUNTIME_JAR_PATH=/path/to/runtime.jar
FALLBACK_ARTIFACT_PATH=/path/to/target/springboot-0.0.1-SNAPSHOT.jar
BACKEND_SOURCE_DIR=/path/to/saas-springboot-src
FRONTEND_SOURCE_DIR=/path/to/saas-vue-src
